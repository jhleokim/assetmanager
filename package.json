{
  "name": "assetmanager",
  "version": "1.1.1",
  "description": "가족 통합 자산관리 시스템",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node tools/build.js",
    "test": "node --test core/*.test.js worker/*.test.js",
    "test:watch": "node --test --watch core/*.test.js worker/*.test.js",
    "dev": "npm run build && wrangler dev --env dev",
    "deploy": "npm run build && wrangler deploy",
    "smoke": "npm run build && node tools/smoke.js"
  },
  "engines": {
    "node": ">=22"
  }
}
